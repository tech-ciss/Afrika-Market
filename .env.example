# --- Base de données ---
# SQLite en développement. En production : postgresql://user:pass@host:5432/afrika_market
DATABASE_URL="file:./dev.db"

# --- Authentification Auth.js ---
AUTH_SECRET="remplacer-par-une-chaine-secrete-aleatoire"
AUTH_URL="http://localhost:3000"
# Cookie de session (prod: __Secure-authjs.session-token)
AUTH_TRUST_HOST=true

# --- Application ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AFRIKA MARKET"
NEXT_PUBLIC_CURRENCY="XOF"

# --- Paiement (simulation par défaut) ---
# Provider réel : wave | orange | mtn | moov | stripe
PAYMENT_PROVIDER="sandbox"
PAYMENT_WEBHOOK_SECRET="remplacer-par-un-secret-webhook"

# --- Email (optionnel) ---
RESEND_API_KEY=""
EMAIL_FROM="AFRIKA MARKET <no-reply@afrikamarket.ci>"

# --- Upload d'images (optionnel) ---
CLOUDINARY_URL=""
