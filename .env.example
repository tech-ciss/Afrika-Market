# ───────────── AFRIKA MARKET — variables d'environnement ─────────────
# Copier ce fichier en `.env` puis renseigner les valeurs. Ne JAMAIS commiter `.env`.

# Base PostgreSQL (Neon, Supabase…)
# DATABASE_URL : URL poolée (utilisée par l'application)
# DIRECT_URL   : URL directe, sans pooler (utilisée par `prisma migrate`)
# Sans pooler, mettre la même URL dans les deux variables.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Auth.js — générer avec : openssl rand -base64 32
AUTH_SECRET=""

# Paiement
# sandbox (défaut) = page de simulation signée ; aucun vrai débit.
PAYMENT_PROVIDER="sandbox"
# Secret HMAC du webhook de paiement — OBLIGATOIRE en production (openssl rand -base64 32)
PAYMENT_WEBHOOK_SECRET=""

# Cron d'expiration des commandes impayées (Vercel l'envoie en `Authorization: Bearer`)
CRON_SECRET=""
# Délai avant expiration d'une commande impayée (minutes, défaut 30)
UNPAID_ORDER_TTL_MINUTES="30"

# URL publique du site (sitemap, robots.txt, Open Graph) — sans slash final
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# "true" = affiche les comptes de démonstration sur /connexion. Laisser vide/false pour un vrai site.
NEXT_PUBLIC_DEMO_MODE="true"
